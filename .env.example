# Run npm run setup to generate a strong server token.
HORIZON_TOKEN=
HORIZON_MEDIA_DIR=./media
HORIZON_DATA_DIR=./.horizon/server
HORIZON_HOST=127.0.0.1
HORIZON_PORT=8090
# Set to true for network filesystems that do not emit reliable events.
HORIZON_WATCH_POLLING=false
# ffprobe is used only to inspect files. No transcoding is performed.
HORIZON_FFPROBE=ffprobe
# Optional client development defaults. Never included in release packages.
TMDB_API_KEY=
HORIZON_SERVER_URL=http://127.0.0.1:8090
# Optional playback engine override. Leave blank to use the bundled mpv.
HORIZON_MPV_PATH=
