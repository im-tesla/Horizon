[Unit]
Description=Horizon original-quality media server
After=network.target

[Service]
Type=simple
User=horizon
WorkingDirectory=/opt/horizon
EnvironmentFile=/etc/horizon.env
ExecStart=/usr/bin/node /opt/horizon/horizon-server.mjs start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/horizon /opt/horizon/.horizon

[Install]
WantedBy=multi-user.target
